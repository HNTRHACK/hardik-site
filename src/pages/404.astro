---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · Hardik Bhatia" description="This page doesn’t exist. Head back to the home page." og="home">
  <section class="wrap lost">
    <div class="hero__card">
      <div class="hero__circle" aria-hidden="true"></div>
      <div>
        <p class="mono">404</p>
        <h1 class="hero__title">This page isn’t here.</h1>
      </div>
      <div class="hero__foot">
        <a class="pill pill--ink" href="/">Back to the home page</a>
      </div>
    </div>
  </section>
</Base>
