---
import { site } from '../data/site';

const { home = false } = Astro.props as { home?: boolean };
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__inner">
    <p>© {year} {site.name} · Mumbai</p>
    <nav aria-label="Footer">
      <ul>
        <li><a href={site.github} rel="me">GitHub</a></li>
        <li><a href={site.linkedin} rel="me">LinkedIn</a></li>
        <li><a href={site.lane}>Hardik’s Lane</a></li>
        <li><a href={home ? '#top' : '/'}>{home ? 'Back to top' : 'Home'}</a></li>
      </ul>
    </nav>
  </div>
</footer>
