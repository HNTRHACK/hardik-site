---
import { hero, whatIDo, site } from '../data/site';
---
<section class="wrap hero" id="top" aria-labelledby="hero-title">
  <div class="grid hero__grid">
    <div class="hero__card">
      <div class="hero__circle" aria-hidden="true"></div>
      <h1 class="hero__title" id="hero-title">{hero.intro}</h1>
      <div class="hero__foot">
        <a class="hero__scroll" href="#about">Scroll <span aria-hidden="true">↓</span></a>
        <p class="hero__meta">{site.role} · <a href="#hi">Open to internships</a></p>
      </div>
    </div>
    <div class="hero__panel">
      <h2>What I do</h2>
      <ul class="do-list">
        {whatIDo.map((d) => (
          <li>
            <h3>{d.title}</h3>
            <p>{d.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
